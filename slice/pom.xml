<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.openchemlib</groupId>
  <artifactId>openchemlib-wasm-slice</artifactId>
  <version>0.0.0</version>
  <packaging>jar</packaging>

  <!--
    Stage 2 vertical slice: does the REAL vendored OpenChemLib source compile and
    run under TeaVM WasmGC? Exercises the substructure path end to end:
    SmilesParser -> StereoMolecule -> Canonizer (idcode) -> SSSearcherWithIndex
    (long[] fingerprint screen) -> SSSearcher (graph isomorphism). TeaVM's
    whole-program dead-code elimination compiles only the reachable subset, so
    AWT depiction / editor / unrelated parsers are never touched.
  -->

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <teavm.version>0.14.1</teavm.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
      <version>${teavm.version}</version>
    </dependency>
    <!-- See spike/README.md: teavm-core is runtime-scoped in teavm-classlib but
         the plugin analyzes only the compile classpath; declare it explicitly. -->
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-core</artifactId>
      <version>${teavm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso</artifactId>
      <version>${teavm.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Stage 2 benchmark POC. The OpenChemLib source is no longer duplicated
        here; it is pulled on demand from the shared vendored copy in ../java via
        -sourcepath, so only the substructure closure compiles (off-path files are
        never touched). Run `npm run copy:openchemlib` first if ../java is empty.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <includes>
            <include>org/openchemlib/wasm/slice/SubstructureSlice.java</include>
          </includes>
          <compilerArgs>
            <arg>-sourcepath</arg>
            <arg>${project.basedir}/src/main/java:${project.basedir}/../java/src/main/java</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-maven-plugin</artifactId>
        <version>${teavm.version}</version>
        <executions>
          <execution>
            <id>wasm-gc-compile</id>
            <phase>process-classes</phase>
            <goals>
              <goal>compile</goal>
            </goals>
            <configuration>
              <targetType>WEBASSEMBLY_GC</targetType>
              <mainClass>org.openchemlib.wasm.slice.SubstructureSlice</mainClass>
              <targetDirectory>${project.build.directory}/wasm-gc</targetDirectory>
              <targetFileName>slice.wasm</targetFileName>
              <minifying>false</minifying>
              <!-- Performance tuning experiment: FULL optimization, no strict
                   null/array-bounds checks, assertions stripped. -->
              <optimizationLevel>FULL</optimizationLevel>
              <strict>false</strict>
              <assertionsRemoved>true</assertionsRemoved>
            </configuration>
          </execution>
          <execution>
            <id>wasm-gc-runtime</id>
            <phase>process-classes</phase>
            <goals>
              <goal>copy-webassembly-gc-runtime</goal>
            </goals>
            <configuration>
              <targetDirectory>${project.build.directory}/wasm-gc</targetDirectory>
              <runtimeFileName>slice.wasm-runtime.js</runtimeFileName>
              <modular>true</modular>
              <minified>false</minified>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

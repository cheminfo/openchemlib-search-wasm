{
  "name": "openchemlib-wasm",
  "version": "0.0.0",
  "type": "module",
  "description": "Batch substructure and similarity search over idcodes, with OpenChemLib compiled to WebAssembly",
  "keywords": [
    "chemistry",
    "molecule",
    "substructure",
    "similarity",
    "openchemlib",
    "webassembly"
  ],
  "scripts": {
    "benchmark": "node benchmark/ssSearch.js",
    "benchmark-scan": "node benchmark/scan.mjs",
    "build": "npm run build-wasm && npm run build-embed",
    "build-embed": "node build/embed-wasm.mjs",
    "build-wasm": "node scripts/build-wasm.mjs",
    "check-types": "tsc --noEmit",
    "clean": "rimraf coverage lib",
    "dataset": "node scripts/build-dataset.mjs",
    "dev": "vite dev dev",
    "eslint": "eslint .",
    "eslint-fix": "eslint . --fix",
    "prepack": "npm run tsc",
    "prettier": "prettier --check .",
    "prettier-write": "prettier --write .",
    "test": "npm run test-only && npm run check-types && npm run eslint && npm run prettier",
    "test-only": "vitest run --coverage",
    "tsc": "npm run clean && npm run tsc-build",
    "tsc-build": "tsc --project tsconfig.build.json"
  },
  "exports": {
    ".": "./lib/index.js"
  },
  "imports": {
    "#lib": "./src/index.ts"
  },
  "files": [
    "lib",
    "src",
    "wasm"
  ],
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@types/benchmark": "^2.1.5",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@zakodium/tsconfig": "^1.0.5",
    "benchmark": "^2.1.4",
    "eslint": "^9.39.4",
    "eslint-config-cheminfo-typescript": "^22.1.0",
    "globals": "^17.6.0",
    "openchemlib": "^9.22.1",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}

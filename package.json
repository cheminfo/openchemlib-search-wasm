{
  "name": "openchemlib-wasm",
  "version": "0.0.0",
  "type": "module",
  "description": "OpenChemLib compiled to WebAssembly",
  "keywords": [
    "chemistry",
    "molecule",
    "smiles",
    "webassembly",
    "wasm"
  ],
  "scripts": {
    "build": "npm run build-wasm && npm run build-embed",
    "build-embed": "node build/embed-wasm.mjs",
    "build-wasm": "mvn -B -f java/pom.xml process-classes",
    "copy:openchemlib": "node scripts/copy-openchemlib.mjs",
    "check-types": "tsc --noEmit",
    "eslint": "eslint src",
    "eslint-fix": "eslint src --fix",
    "prettier": "prettier --check src",
    "prettier-write": "prettier --write src",
    "test": "npm run test-only && npm run check-types && npm run eslint && npm run prettier",
    "test-only": "vitest run"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "#lib": "./src/index.ts"
  },
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "eslint": "^9.39.4",
    "eslint-config-cheminfo-typescript": "^22.0.0",
    "globals": "^17.6.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.openchemlib</groupId>
  <artifactId>openchemlib-wasm-spike</artifactId>
  <version>0.0.0</version>
  <packaging>jar</packaging>

  <!--
    Stage 0 toolchain spike: prove TeaVM 0.14.1 can compile a trivial OCL-style
    long[] bit-op class to a WasmGC module, @JSExport it, and run it under Node
    with correct 64-bit (i64) semantics. This is the go/no-go gate for the full
    openchemlib-wasm port. It deliberately depends on NOTHING from OpenChemLib.
  -->

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <teavm.version>0.14.1</teavm.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
      <version>${teavm.version}</version>
    </dependency>
    <!--
      teavm-classlib declares teavm-core at <scope>runtime</scope>, but the
      TeaVM maven plugin analyzes only the compile-scope classpath, so the
      runtime support classes it must compile into the module (notably
      org.teavm.runtime.Fiber) are not found and the WasmGC build fails with
      "fiberClass is null". Pull teavm-core onto the compile classpath.
    -->
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-core</artifactId>
      <version>${teavm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso</artifactId>
      <version>${teavm.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-maven-plugin</artifactId>
        <version>${teavm.version}</version>
        <executions>
          <execution>
            <id>wasm-gc-compile</id>
            <phase>process-classes</phase>
            <goals>
              <goal>compile</goal>
            </goals>
            <configuration>
              <targetType>WEBASSEMBLY_GC</targetType>
              <mainClass>org.openchemlib.wasm.spike.Screen</mainClass>
              <targetDirectory>${project.build.directory}/wasm-gc</targetDirectory>
              <targetFileName>spike.wasm</targetFileName>
              <minifying>false</minifying>
            </configuration>
          </execution>
          <execution>
            <id>wasm-gc-runtime</id>
            <phase>process-classes</phase>
            <goals>
              <goal>copy-webassembly-gc-runtime</goal>
            </goals>
            <configuration>
              <targetDirectory>${project.build.directory}/wasm-gc</targetDirectory>
              <runtimeFileName>spike.wasm-runtime.js</runtimeFileName>
              <modular>true</modular>
              <minified>false</minified>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
